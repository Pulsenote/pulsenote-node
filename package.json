{
  "name": "pulsenote",
  "version": "1.0.0",
  "description": "Official TypeScript/Node SDK for the Pulsenote email API.",
  "author": "GP IT-Tech",
  "license": "MIT",
  "homepage": "https://pulsenote.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsenote/pulsenote-node.git"
  },
  "bugs": {
    "url": "https://github.com/Pulsenote/pulsenote-node/issues"
  },
  "keywords": [
    "pulsenote",
    "email",
    "transactional-email",
    "sdk",
    "api-client",
    "notifications",
    "nodemailer",
    "smtp"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nodemailer": {
      "import": {
        "types": "./dist/nodemailer.d.ts",
        "default": "./dist/nodemailer.js"
      },
      "require": {
        "types": "./dist/nodemailer.d.cts",
        "default": "./dist/nodemailer.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "clean": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "nodemailer": "^9.0.5",
    "openapi-typescript": "^7.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "//overrides": [
    "Advisory fixes for transitive dev dependencies. The published package has no",
    "runtime dependencies, so none of these ever reach a consumer — but the",
    "lockfile is what Dependabot scans, so they are pinned rather than dismissed.",
    "js-yaml + brace-expansion come via openapi-typescript > @redocly/openapi-core,",
    "which pins js-yaml exactly at 4.2.0; esbuild comes via tsup and vitest."
  ],
  "overrides": {
    "js-yaml": "^4.3.0",
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "nodemailer": ">=6"
  },
  "peerDependenciesMeta": {
    "nodemailer": {
      "optional": true
    }
  }
}
