{
  "name": "pulsenote",
  "version": "0.1.0",
  "description": "Official TypeScript/Node SDK for the Pulsenote email API.",
  "author": "GP IT-Tech",
  "license": "MIT",
  "homepage": "https://pulsenote.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pulsenote/pulsenote-node.git"
  },
  "bugs": {
    "url": "https://github.com/Pulsenote/pulsenote-node/issues"
  },
  "keywords": [
    "pulsenote",
    "email",
    "transactional-email",
    "sdk",
    "api-client",
    "notifications"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "clean": "rm -rf dist",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm run test && npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "openapi-typescript": "^7.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
