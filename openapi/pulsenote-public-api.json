{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/notifications/send": {
      "post": {
        "description": "Queues an email for delivery. Returns immediately with the notification ID.\n\n**Sandbox:** if your account has no verified sending domain yet, the message is rendered and stored for preview but never delivered, and the response comes back with `status: \"SANDBOX\"` and `sandbox: true`. Everything else behaves identically — including the `from` address you pass — so verifying a domain in Settings is the only change needed to start sending for real. Sandbox is capped at 50 messages/month and does not consume your plan allowance.",
        "operationId": "sendNotification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Notification queued successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API key"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Send an email notification",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/api/v1/notifications/batch": {
      "post": {
        "description": "Queues up to 500 emails in one call. Each message is validated independently; the response reports per-message queued/rejected status.",
        "operationId": "sendNotificationBatch",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchSendDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Batch processed (see per-message results)"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Send a batch of email notifications",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/api/v1/notifications/stats": {
      "get": {
        "description": "Returns total counts by status, daily breakdown for last 30 days, and this month total.",
        "operationId": "getNotificationStats",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Aggregate statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationStatsDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Get notification statistics",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "description": "Paginated list of sent notifications for this tenant.",
        "operationId": "listNotifications",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "PENDING",
                "QUEUED",
                "SENT",
                "DELIVERED",
                "FAILED",
                "BOUNCED",
                "SANDBOX"
              ],
              "type": "string"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Match recipient or subject (case-insensitive).",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated notifications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "List notifications",
        "tags": [
          "Notifications"
        ]
      }
    },
    "/api/v1/notifications/{id}": {
      "get": {
        "description": "Returns full details of a single notification including delivery status.",
        "operationId": "getNotification",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationDto"
                }
              }
            }
          },
          "404": {
            "description": "Notification not found"
          }
        },
        "security": [
          {
            "api-key": []
          }
        ],
        "summary": "Get notification by ID",
        "tags": [
          "Notifications"
        ]
      }
    },
