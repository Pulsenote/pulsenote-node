  },
  "info": {
    "title": "Pulsenote API",
    "description": "Send transactional emails at scale. Authenticate every request with your API key in the `X-API-Key` header. Find your key in the Pulsenote dashboard under Settings → API Keys.",
    "version": "1.0",
    "contact": {
      "name": "Pulsenote",
      "url": "https://pulsenote.eu",
      "email": "support@pulsenote.eu"
    }
  },
  "tags": [
    {
      "name": "Notifications",
      "description": "Send emails, check delivery status, and view statistics."
    },
    {
      "name": "Templates",
      "description": "Create and manage reusable email templates with variable interpolation."
    },
    {
      "name": "Domains",
      "description": "Register sender domains and verify them via DNS."
    }
  ],
  "servers": [
    {
      "url": "https://api.pulsenote.eu",
      "description": "Production"
    },
    {
      "url": "https://pulsenote-api.sysgp.eu",
      "description": "Staging"
    }
  ],
  "components": {
    "securitySchemes": {
      "api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Your tenant API key. Find it in the dashboard under Settings → API Keys."
      }
    },
    "schemas": {
      "EmailAttachmentDto": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "File name shown to the recipient, e.g. `invoice-2026-08.pdf`."
          },
          "content": {
            "type": "string",
            "description": "Base64-encoded file contents."
          },
          "contentType": {
            "type": "string",
            "description": "MIME type. Defaults to `application/octet-stream`.",
            "example": "application/pdf"
          },
          "contentId": {
            "type": "string",
            "description": "Embed the file in the HTML body instead of listing it as a download. Reference it as `cid:<contentId>` in your HTML."
          }
        },
        "required": [
          "filename",
          "content"
        ]
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "format": "email",
            "description": "Recipient email address."
          },
          "cc": {
            "description": "Carbon-copy recipients, visible to everyone on the message. Accepts a single address or a list. Counts toward the 50-recipient limit shared with `to` and `bcc`.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bcc": {
            "description": "Blind-carbon-copy recipients, hidden from other recipients. Accepts a single address or a list. Counts toward the 50-recipient limit shared with `to` and `cc`.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "replyTo": {
            "description": "Where replies should go, when that differs from `from`. Accepts a single address or a list. Unlike `from`, these addresses do not need to be on a verified domain.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "attachments": {
            "description": "Files to attach, up to 20 per message and 10 MB in total (decoded).",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailAttachmentDto"
            }
          },
          "from": {
            "type": "string",
            "description": "Sender address on a verified domain. Defaults to the tenant default sender."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line. Ignored when a template supplies its own subject."
          },
          "templateId": {
            "type": "string",
            "description": "Send using a stored template by ID.",
            "format": "uuid"
          },
          "templateSlug": {
            "type": "string",
            "description": "Send using a stored template by slug."
          },
          "locale": {
            "type": "string",
            "description": "Locale of the template variant to use (e.g. en, pl)."
          },
          "templateData": {
            "type": "object",
            "additionalProperties": true,
            "description": "Variables interpolated into the template."
          },
          "html": {
            "type": "string",
            "description": "Raw HTML body (when not using a template)."
          },
          "text": {
            "type": "string",
            "description": "Plain-text body."
          },
          "stream": {
            "type": "string",
            "enum": [
              "transactional",
              "broadcast"
            ],
            "description": "Message stream — transactional (default) or broadcast. Isolates reputation + suppression."
          }
        },
        "required": [
          "to"
        ]
      },
      "SendEmailResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ID of the queued notification.",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "PENDING",
              "QUEUED",
              "SENT",
              "DELIVERED",
              "FAILED",
              "BOUNCED",
              "SANDBOX"
            ],
            "type": "string",
            "description": "Status at time of acceptance. `QUEUED` for a normal send. `SANDBOX` when the account has no verified sending domain — the message is rendered and stored for preview but never delivered."
          },
          "from": {
            "type": "string",
            "description": "Resolved sender address the email will be sent from."
          },
          "sandbox": {
            "type": "boolean",
            "description": "Present and `true` only in sandbox mode. Check this in your integration tests to assert you are sending for real. Verify a sending domain to leave sandbox — no code changes are required."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation, returned in sandbox mode."
          }
        },
        "required": [
          "id",
          "status",
          "from"
        ]
      },
      "BatchSendDto": {
        "type": "object",
        "properties": {
          "messages": {
            "description": "Up to 500 messages to queue in one call.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SendEmailDto"
            }
          }
        },
        "required": [
          "messages"
        ]
      },
      "NotificationStatsDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total notifications across all statuses."
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Count keyed by status.",
            "example": {
              "DELIVERED": 120,
              "BOUNCED": 3,
              "QUEUED": 5
            }
          },
          "thisMonth": {
            "type": "number",
            "description": "Total notifications sent this calendar month."
          },
          "daily": {
            "type": "array",
            "description": "Per-day counts by status for the last 30 days.",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "example": [
              {
                "date": "2026-07-08",
                "DELIVERED": 40,
                "BOUNCED": 1
              }
            ]
          }
        },
        "required": [
          "total",
          "counts",
          "thisMonth",
          "daily"
        ]
      },
      "NotificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "recipient": {
            "type": "string",
            "description": "Recipient email address."
          },
          "subject": {
            "type": "string",
            "description": "Email subject line."
          },
          "templateId": {
            "type": "string",
            "description": "ID of the template used, if any.",
            "format": "uuid"
          },
          "templateName": {
            "type": "string",
            "description": "Name of the template used, if any."
          },
          "fromAddress": {
            "type": "string",
            "description": "Sender email address."
          },
          "status": {
            "enum": [
              "PENDING",
              "QUEUED",
              "SENT",
              "DELIVERED",
              "FAILED",
              "BOUNCED",
              "SANDBOX"
            ],
            "type": "string",
            "description": "Current delivery status."
          },
          "providerMessageId": {
            "type": "string",
            "description": "Upstream provider (SES) message ID."
          },
          "sentAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the email was handed to the provider."
          },
          "deliveredAt": {
            "type": "string",
            "format": "date-time",
            "description": "When delivery was confirmed."
          },
          "failedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the send failed."
          },
          "failureReason": {
            "type": "string",
            "description": "Reason for failure, if failed or bounced."
          },
          "createdAt": {
            "type": "string",
