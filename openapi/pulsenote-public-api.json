            "type": "boolean"
          },
          "dmarcVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "domain",
          "status",
          "records",
          "spfVerified",
          "dkimVerified",
          "dmarcVerified"
        ]
      }
