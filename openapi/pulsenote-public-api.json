            }
          }
        },
        "required": [
          "id",
          "domain",
          "status",
          "spfVerified",
          "dkimVerified",
          "dmarcVerified",
          "isDefault",
          "createdAt",
          "updatedAt"
        ]
      },
      "AddDomainDto": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "Domain to send from, e.g. mail.example.com."
          },
          "fromEmail": {
            "type": "string",
            "format": "email",
            "description": "Default from address for this domain. Defaults to noreply@<domain>."
          },
          "fromName": {
            "type": "string",
            "description": "Default display name for this domain."
          },
          "region": {
            "type": "string",
            "enum": [
              "eu-west-1"
